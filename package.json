{
  "name": "moneygame-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:types": "npm --prefix packages/shared-types run build",
    "build:server": "npm --prefix apps/server run build",
    "build:admin-web": "npm --prefix apps/admin-web run build",
    "build:user-web": "npm --prefix apps/user-web run build",
    "build": "npm run build:types && npm run build:server && npm run build:admin-web && npm run build:user-web",
    "dev:server": "npm --prefix apps/server run dev",
    "start:server": "npm --prefix apps/server run start",
    "dev:user-web": "npm --prefix apps/user-web run dev",
    "dev:admin-web": "npm --prefix apps/admin-web run dev",
    "test:auth": "npm --prefix apps/server run test:auth",
    "test:admin": "npm --prefix apps/server run test:admin",
    "test:user-app": "(cd apps/user-app && flutter test)",
    "test:admin-app": "(cd apps/admin-app && flutter test)",
    "analyze:flutter": "(cd apps/user-app && flutter analyze) && (cd apps/admin-app && flutter analyze)",
    "test": "npm run test:auth && npm run test:admin && npm run test:user-app && npm run test:admin-app"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
