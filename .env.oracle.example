# Environment configuration for Oracle Cloud VM Deployment (Side-by-side with NithConnect)
PORT=4000
NODE_ENV=production

# Connect to either existing nith_connect_db (creating money_game database) or a separate container
DATABASE_URL="postgresql://nith_user:YOUR_POSTGRES_PASSWORD@localhost:5432/money_game?schema=public"

# Admin UPI configuration (Can also be rotated in live admin dashboard)
ADMIN_UPI_ID="admin@okhdfcbank"
ADMIN_UPI_NAME="MoneyGame Admin"

# Webhook secret to verify incoming Android / Email notification forwarder
WEBHOOK_SECRET=

# Commission percentage deducted from room prize pool
PLATFORM_COMMISSION_PERCENT=10

JWT_SECRET=

# Generate independent secrets: openssl rand -hex 32
# JWT_SECRET and WEBHOOK_SECRET are required in production (at least 32 characters).
# Required when creating the first admin; use a unique password (at least 12 characters).
ADMIN_INITIAL_EMAIL=admin@moneygame.com
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PHONE=9999999999
# For Docker SQLite use: DATABASE_URL=file:/app/data/moneygame.db
