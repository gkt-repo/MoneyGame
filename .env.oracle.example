# =======================================================
# 🚀 MoneyGame Production Configuration (Oracle Cloud VM)
# Completely isolated alongside NithConnect (Zero interference)
# =======================================================

PORT=4000
NODE_ENV=production

# Database Configuration (Dedicated side-by-side money_game_db container)
# Note: money_game_db runs on port 5433 (host) / port 5432 (internal Docker network)
# so it NEVER conflicts with nith_connect_db (port 5432).
POSTGRES_DB=money_game
POSTGRES_USER=money_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5433

# Internal Docker URL used by money_game_app:
DATABASE_URL="postgresql://money_user:your_secure_postgres_password_here@money_game_db:5432/money_game?schema=public"

# Admin UPI configuration (Can also be rotated in live admin dashboard)
ADMIN_UPI_ID="admin@okhdfcbank"
ADMIN_UPI_NAME="MoneyGame Admin"
PLATFORM_COMMISSION_PERCENT=10

# Security Secrets (Must be at least 32 characters: openssl rand -hex 32)
WEBHOOK_SECRET=
JWT_SECRET=

# Allowed CORS Origins (comma-separated, e.g. https://mygame.web.app, or * for all)
ALLOWED_ORIGINS="*"

# Initial Super Admin credentials
ADMIN_INITIAL_EMAIL=admin@moneygame.com
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PHONE=9999999999

# Email / SMTP Configuration (Optional, for password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MoneyGame <no-reply@moneygame.com>"
