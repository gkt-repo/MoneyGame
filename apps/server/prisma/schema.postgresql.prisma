// prisma/schema.postgresql.prisma - For Oracle VM Deployment (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  phone             String?            @unique
  email             String?            @unique
  passwordHash      String             @default("")
  role              String             @default("USER") // USER, ADMIN, SUPER_ADMIN
  status            String             @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  wallet            Wallet?
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  roomPlayers       RoomPlayer[]
  transactions      Transaction[]
  roomsWon          Room[]             @relation("RoomWinner")
  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  auditLogsTarget   AuditLog[]         @relation("TargetUser")
  adminActions      AuditLog[]         @relation("ActorAdmin")
  feedbacks         Feedback[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float    @default(0.0)
  lockedBalance Float    @default(0.0)
  updatedAt     DateTime @default(now()) @updatedAt
}

model Deposit {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseAmount       Float
  offsetPaise      Int
  totalAmount      Float             @unique
  receivingUpi     String
  status           String            @default("PENDING") // PENDING, CLAIMED, APPROVED, EXPIRED, REJECTED
  utr              String?           @unique
  userClaimedUtr   String?
  claimStatus      String?           // NONE, CLAIMED_BY_USER, AUTO_MATCHED, MANUALLY_VERIFIED
  approvedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())

  unmatchedPayment UnmatchedPayment?

  @@index([userId])
  @@index([userClaimedUtr])
  @@index([status])
}

model UnmatchedPayment {
  id                String    @id @default(uuid())
  amount            Float
  utr               String?   @unique
  senderUpi         String?
  senderName        String?
  rawPayload        String?
  status            String    @default("UNCLAIMED") // UNCLAIMED, ASSIGNED, REFUNDED
  assignedDepositId String?   @unique
  assignedDeposit   Deposit?  @relation(fields: [assignedDepositId], references: [id], onDelete: SetNull)
  assignedUserId    String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([status])
  @@index([utr])
}

model Withdrawal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  upiId     String
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  payoutUtr String?  @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Room {
  id            String       @id @default(uuid())
  roomCode      String       @unique
  entryFee      Float
  maxPlayers    Int          @default(2)
  status        String       @default("WAITING") // WAITING, PLAYING, COMPLETED, CANCELLED
  winningNumber Int?
  winnerId      String?
  winner        User?        @relation("RoomWinner", fields: [winnerId], references: [id])
  players       RoomPlayer[]
  createdAt     DateTime     @default(now())
}

model RoomPlayer {
  id          String   @id @default(uuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guessNumber Int
  joinedAt    DateTime @default(now())

  @@unique([roomId, userId])
  @@unique([roomId, guessNumber])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // DEPOSIT, ROOM_ENTRY, ROOM_WIN, WITHDRAWAL_LOCK, WITHDRAWAL_COMPLETE, REFUND
  referenceId String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("ActorAdmin", fields: [actorId], references: [id])
  action    String   // e.g. "APPROVE_WITHDRAWAL", "CHANGE_UPI", "BAN_USER", "MANUAL_ADJUST"
  targetId  String?
  target    User?    @relation("TargetUser", fields: [targetId], references: [id])
  details   String?  // JSON text of action
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Feedback {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String    @default("GENERAL") // DEPOSIT, WITHDRAWAL, GAME, ACCOUNT, GENERAL, BUG
  subject     String
  message     String
  contactInfo String?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  adminReply  String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
}

