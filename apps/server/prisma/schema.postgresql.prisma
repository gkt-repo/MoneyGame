// PostgreSQL production schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  tradingAccounts TradingAccount[]
  id                String             @id @default(uuid())
  username          String             @unique
  displayName       String?
  avatar            String?            @default("avatar_1")
  phone             String?            @unique
  email             String?            @unique
  passwordHash      String             @default("")
  role              String             @default("USER") // USER, MODERATOR, ADMIN, SUPER_ADMIN
  status            String             @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  tokenVersion      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  wallet            Wallet?
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  roomPlayers       RoomPlayer[]
  transactions      Transaction[]
  roomsWon          Room[]             @relation("RoomWinner")
  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  auditLogsTarget   AuditLog[]         @relation("TargetUser")
  adminActions      AuditLog[]         @relation("ActorAdmin")
  feedbacks         Feedback[]
  notifications     Notification[]
  upiAccount        UpiAccount?
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float    @default(0.0)
  lockedBalance Float    @default(0.0)
  updatedAt     DateTime @default(now()) @updatedAt
}

model Deposit {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseAmount       Float
  offsetPaise      Int
  totalAmount      Float
  activeAmountKey  Int?              @unique // amount in paise, held only while active
  receivingUpi     String
  upiAccountId     String?
  allocationDay    String?
  status           String            @default("PENDING") // PENDING, CLAIMED, APPROVED, EXPIRED, REJECTED
  utr              String?           @unique
  userClaimedUtr   String?
  claimStatus      String?           // NONE, CLAIMED_BY_USER, AUTO_MATCHED, MANUALLY_VERIFIED
  approvedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())

  unmatchedPayment UnmatchedPayment?

  @@index([userId])
  @@index([userClaimedUtr])
  @@index([status])
  @@index([totalAmount])
}

model UnmatchedPayment {
  id                String    @id @default(uuid())
  amount            Float
  utr               String?   @unique
  senderUpi         String?
  senderName        String?
  rawPayload        String?
  receivingUpi      String?
  reportedById      String?
  status            String    @default("UNCLAIMED") // UNCLAIMED, ASSIGNED, REFUNDED
  assignedDepositId String?   @unique
  assignedDeposit   Deposit?  @relation(fields: [assignedDepositId], references: [id], onDelete: SetNull)
  assignedUserId    String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([status])
  @@index([utr])
}

model Withdrawal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  upiId     String
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  payoutUtr String?  @unique
  assignedModeratorId String?
  assignedAt DateTime?
  payoutAccountId String? // Stable funding account, independent of its current operator
  fundingSource String? // ACCOUNT or EXTERNAL (explicit admin-funded payout)
  processingById String?
  processedById String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([assignedModeratorId, status])
  @@index([status, assignedAt])
}

model Room {
  id              String       @id @default(uuid())
  roomCode        String       @unique
  invitationToken String?      @unique
  invitationExpiresAt DateTime?
  invitationRevokedAt DateTime?
  engineState     String?
  engineSequence  Int          @default(0)
  isPrivate       Boolean      @default(false)
  gameType        String       @default("GUESS_NUMBER") // GUESS_NUMBER, TEEN_PATTI, TWENTY_NINE
  entryFee      Float
  maxPlayers    Int          @default(2)
  status        String       @default("WAITING") // WAITING, COUNTDOWN, PLAYING, ROLLING, COMPLETED, CANCELLED
  winningNumber Int?
  winnerId      String?
  winnerPrize   Float?
  customConfig  String?
  winner        User?        @relation("RoomWinner", fields: [winnerId], references: [id])
  players       RoomPlayer[]
  createdAt     DateTime     @default(now())
}

model RoomPlayer {
  id          String   @id @default(uuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex   Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE, FOLDED, SITTING_OUT
  guessNumber Int?
  joinedAt    DateTime @default(now())

  @@unique([roomId, userId])
  @@unique([roomId, seatIndex])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // DEPOSIT, ROOM_ENTRY, ROOM_WIN, WITHDRAWAL_LOCK, WITHDRAWAL_COMPLETE, REFUND
  referenceId String?
  idempotencyKey String? @unique
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("ActorAdmin", fields: [actorId], references: [id])
  action    String   // e.g. "APPROVE_WITHDRAWAL", "CHANGE_UPI", "BAN_USER", "MANUAL_ADJUST"
  targetId  String?
  target    User?    @relation("TargetUser", fields: [targetId], references: [id])
  details   String?  // JSON text of action
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Feedback {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String    @default("GENERAL") // DEPOSIT, WITHDRAWAL, GAME, ACCOUNT, GENERAL, BUG
  subject     String
  message     String
  contactInfo String?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  adminReply  String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // WITHDRAWAL_COMPLETED, WITHDRAWAL_REJECTED, WITHDRAWAL_REQUESTED, DEPOSIT_APPROVED, ROOM_WIN, FEEDBACK_REPLY, SYSTEM
  isRead    Boolean  @default(false)
  metadata  String?  // JSON text with e.g. utr, amount, referenceId
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model UpiAccount {
  id             String    @id @default(uuid())
  upiId          String    @unique
  receiverName   String
  dailyLimit     Int       @default(15)
  totalDeposited Float @default(0)
  totalPaidOut Float @default(0)
  currentBalance Float @default(0)
  reservedPayouts Float @default(0)
  openingAdjustment Float @default(0)
  floatReady Boolean @default(true)
  todayTxCount   Int       @default(0)
  batchCount     Int       @default(0)
  batchSize      Int       @default(2)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  assignedUserId String?   @unique
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  listenerTokenHash String? @unique
  lastHeartbeatAt DateTime?
  listenerConnected Boolean @default(false)
  batteryLevel Int?
  phoneModel String?
  usage UpiDailyUsage[]
  lastResetAt    DateTime  @default(now())
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([assignedUserId])
}


// Issued slots remain reserved for the day: expired QR codes can still be paid.
model UpiDailyUsage {
  id String @id @default(uuid())
  accountId String
  account UpiAccount @relation(fields: [accountId], references: [id])
  day String
  issuedCount Int @default(0)
  receivedCount Int @default(0)
  @@unique([accountId, day])
}

// Append-only cash movements. Cached account balances are updated in the same transaction.
model CashDeskEntry {
  id String @id @default(uuid())
  accountId String
  amount Float
  kind String // DEPOSIT, PAYOUT, OPENING_ADJUSTMENT
  sourceKey String @unique
  actorId String?
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}


model TradingMarket {
  id String @id @default(uuid())
  source String
  mode String @default("TEST")
  title String
  team0 String
  team1 String
  status String @default("SUSPENDED")
  reason String @default("")
  rulesVersion String @default("pooled-v1")
  platformSurplus BigInt @default(0)
  modelVersion String @default("cricket-baseline-v1")
  sequence Int @default(0)
  revision Int @default(0)
  fingerprint String @default("")
  snapshot String @default("{}")
  feedReceivedAt DateTime?
  snapshotChangedAt DateTime?
  winner Int?
  adminPaused Boolean @default(false)
  replayStep Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  quotes TradingQuote[]
  accounts TradingAccount[]
  operations TradingOperation[]
}
model TradingQuote {
  id String @id @default(uuid())
  marketId String
  market TradingMarket @relation(fields: [marketId], references: [id], onDelete: Restrict)
  sequence Int
  price0 Int
  priceDraw Int @default(0)
  snapshot String
  publishedAt DateTime @default(now())
  expiresAt DateTime
  @@unique([marketId, sequence])
  @@index([marketId, publishedAt])
}
model TradingAccount {
  id String @id @default(uuid())
  marketId String
  market TradingMarket @relation(fields: [marketId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  deposit Int @default(0)
  balance Int @default(0)
  realized Int @default(0)
  receipt String?
  positions TradingPosition[]
  executions TradingExecution[]
  @@unique([marketId, userId])
}
model TradingPosition {
  id String @id @default(uuid())
  accountId String
  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  outcome Int
  quantity Int @default(0)
  cost Int @default(0)
  @@unique([accountId, outcome])
}
model TradingExecution {
  id String @id @default(uuid())
  accountId String
  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quoteId String
  side String
  outcome Int
  quantity Int
  price Int
  total Int
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}
model TradingOperation {
  id String @id @default(uuid())
  marketId String
  market TradingMarket @relation(fields: [marketId], references: [id], onDelete: Restrict)
  userId String
  requestId String
  payload String
  result String
  createdAt DateTime @default(now())
  @@unique([marketId, userId, requestId])
}
model TradingLease {
  id String @id
  owner String
  expiresAt DateTime
  nextPollAt DateTime
}
