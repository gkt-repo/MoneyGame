# =======================================================
# 🌐 MoneyGame Central Configuration
# =======================================================

PORT=4000
NODE_ENV=production

# Database (PostgreSQL for Production, SQLite for local dev)
DATABASE_URL=postgresql://moneygame_user:your_secure_password@localhost:5432/moneygame_db

# Admin UPI Gateway Config
ADMIN_UPI_ID=8340271508@ptsbi
ADMIN_UPI_NAME=MoneyGame
PLATFORM_COMMISSION_PERCENT=10
WEBHOOK_SECRET=
JWT_SECRET=

# =======================================================
# 📧 Email / SMTP Configuration for Password Reset OTP
# =======================================================
# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-app-password
# SMTP_FROM=MoneyGame Support <your-email@gmail.com>
#
# For Brevo (Sendinblue) / SendGrid / Resend:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-smtp-key
# SMTP_FROM=MoneyGame <no-reply@yourdomain.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MoneyGame <no-reply@moneygame.com>

# Generate independent secrets: openssl rand -hex 32
# JWT_SECRET and WEBHOOK_SECRET are required in production (at least 32 characters).
# Required when creating the first admin; use a unique password (at least 12 characters).
ADMIN_INITIAL_EMAIL=admin@moneygame.com
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PHONE=9999999999
# For Docker SQLite use: DATABASE_URL=file:/app/data/moneygame.db

# Live CricTrade matches debit the wallet at ₹1 = 10 credits. Defaults to enabled.
# Set false to pause new cash funding/buys; valid exits and settlement remain available.
CRICTRADE_CASH_ENABLED=true
