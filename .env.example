# =======================================================
# 🌐 MoneyGame Central Configuration
# =======================================================

PORT=4000
NODE_ENV=production

# Database (PostgreSQL for Production, SQLite for local dev)
DATABASE_URL=postgresql://moneygame_user:your_secure_password@localhost:5432/moneygame_db

# Admin UPI Gateway Config
ADMIN_UPI_ID=8340271508@ptsbi
ADMIN_UPI_NAME=MoneyGame
PLATFORM_COMMISSION_PERCENT=10
WEBHOOK_SECRET=moneygame-secret-key-1234
JWT_SECRET=moneygame-super-secret-jwt-key-change-in-production

# =======================================================
# 📧 Email / SMTP Configuration for Password Reset OTP
# =======================================================
# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-app-password
# SMTP_FROM=MoneyGame Support <your-email@gmail.com>
#
# For Brevo (Sendinblue) / SendGrid / Resend:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-smtp-key
# SMTP_FROM=MoneyGame <no-reply@yourdomain.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MoneyGame <no-reply@moneygame.com>
